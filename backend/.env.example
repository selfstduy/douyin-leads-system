# Application
APP_NAME=Douyin Lead Mining System
DEBUG=false

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/douyin_leads

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Sentiment API
SENTIMENT_API_KEY=
SENTIMENT_API_URL=

# LLM - 通义千问
LLM_API_KEY=sk-your-dashscope-api-key
LLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
LLM_MODEL=qwen-plus
LLM_ADAPTER=http

# CORS (JSON array not supported in .env, use comma-separated or defaults)
# CORS_ORIGINS=["http://localhost:3000"]

# API Quota (daily limits)
DAILY_MAX_COMMENT_REQUESTS=60000
DAILY_MAX_VIDEO_REQUESTS=20000
QUOTA_WARNING_THRESHOLD=0.9
QUOTA_CRITICAL_THRESHOLD=1.0

# DM Queue (private message send queue)
DM_DAILY_GLOBAL_LIMIT=5000
DM_DAILY_SAFE_LIMIT=4000
DM_ACCOUNT_DAILY_LIMIT=100
DM_SEND_WINDOW_START=8
DM_SEND_WINDOW_END=23
DM_USER_DEDUP_DAYS=7
DM_MIN_INTERVAL_SEC=3
DM_MAX_INTERVAL_SEC=8
DM_BATCH_SIZE=8
